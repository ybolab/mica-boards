# The `board-x64` producer: the mos-board-x64 package.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by build-env/deb/build.sh before it is
# sourced. build-env/deb/README.md documents every field.

# One package: the x64 board's rendered configuration and grub-editenv. NOT the
# kernel -- that is boards/x64/bsp's output, packaged by the kernel-x64
# producer beside this one -- and NOT the ESP's grub.cfg, which is build-host
# input the image assembler reads from the tree; see the Dockerfile.
PACKAGES="mos-board-x64"

# amd64 only, and not `all`. The payload carries /usr/bin/grub-editenv, an
# amd64 ELF taken out of Debian's grub-common, and the board it configures is
# the x86_64 one -- boards/x64/board.env declares MOS_ARCH=amd64. An `all`
# archive would install on the cx3576 image, whose layout none of these files
# describes.
ARCHES="amd64"

# Everything this producer stages, and none of it is in the driver's own
# context (rootfs/packages-src). The board directory carries the layout, the
# board overlay and this producer's own files; the other three are the shared
# sources whose bytes the package must reproduce.
#
# `rauc` and `overlay` are here because pkgs/rauc/render-config.sh is
# INVOKED rather than reimplemented: it derives the RAUC status file's location
# by matching the META GUID in the shared fstab template, so the renderer and
# that template travel together.
BUILD_CONTEXTS="board=boards/x64 rauc=pkgs/rauc overlay=rootfs/overlay"

# The pinned Debian trixie base, for the stage that takes grub-editenv out of
# grub-common. The same release rootfs/stages/10-base.Dockerfile assembles
# the device root from, which is what makes the extracted binary's libraries
# the ones the image carries.
FROM_IMAGES="MOS_IMAGE_DEBIAN_TRIXIE=IMAGE_DEBIAN_TRIXIE"

# Nothing this package ships is enabled at multi-user.target. Its payload is
# rendered configuration and grub-editenv -- read at boot or exec'd by RAUC,
# not started by systemd. The enablement link it does carry sits under
# local-fs.target.wants, which this field does not count.
ENABLEMENT="mos-board-x64=0"
