# Board hardware and storage policy contain no kernel or boot executable.
PACKAGES="mos-board-cx3576"
ARCHES="arm64"
BUILD_CONTEXTS="board=boards/cx3576 boarddeb=boards/cx3576/deb/board-cx3576 overlay=rootfs/overlay hwinit=boards/cx3576/hwinit boardinit=boards/cx3576/bsp/init boardoverlay=boards/cx3576/overlay"
ENABLEMENT="mos-board-cx3576=6"
