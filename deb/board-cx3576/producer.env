# The `board-cx3576` producer: the cx3576 board package, `mos-board-cx3576`.
#
# Plain `KEY=value` lines only: no logic, no command substitution, no
# expansion. Safe to source from bash and to parse with grep/sed from anything
# else, and checked for that shape by build-env/deb/build.sh before it is
# sourced. build-env/deb/README.md documents every field.
#
# Built by the driver like every other producer here:
#
#   bash build-env/deb/build.sh --producer board-cx3576 --arch arm64
#
# The BSP-dependent half arrives through PREPARE below.

PACKAGES="mos-board-cx3576"

# `arm64` and nothing else. This is one board's payload -- its kernel modules
# are built for the RK3576 and its boot inputs are that SoC's -- so there is no
# architecture-independent rendering of it, and `all` would declare a package
# every x64 image could install.
ARCHES="arm64"

# The host-side step, and why this producer is the only one here that needs
# one. Its BSP artefacts are selected by BSP_OUT and its committed firmware by
# BOARD_DIR -- the same overrides
# rootfs/build.sh accepts -- and a build context in this file is a fixed
# repository-relative path, because these lines never expand a variable. A
# directory chosen at run time therefore cannot be named below; render.sh
# copies what those two select into ${MOS_DEB_STAGE} instead, and the driver
# passes that as the `bin` context. It also runs pkgs/rauc/render-config.sh,
# which reads three files this producer does not own and so must run where the
# repository is, and it refuses a missing BSP artifact before any container has
# been started.
PREPARE="render.sh"

# render.sh honours MOS_DEB_PREFLIGHT=1: asked that way it checks its BSP
# inputs, prints how many it examined and exits without staging anything, so
# build-env/deb/preflight.sh can report this producer's missing inputs
# together with every other producer's before `make os-debs` starts a
# container. Opt-in per producer, because a hook that has not been taught the
# variable would do its full work instead -- the podman hook compiles a
# container engine -- and a pre-flight that compiles is not a pre-flight.
PREFLIGHT="1"

# The main build context is this producer's own directory, and
# Dockerfile.dockerignore excludes all of it. Everything comes over as a named
# context, including this directory itself as `boarddeb`.
#
# Every entry here is a COMMITTED tree, so the payload's provenance is the
# repository path on this line. What is not committed -- the kernel modules,
# the selected firmware, the boot inputs and the rendered configuration --
# arrives as `bin` from PREPARE and is deliberately absent here: a context path
# that does not exist until a script has run has no place in a file that
# describes the tree.
#
# NOT boards/cx3576 as one context: _out/boards/cx3576 is a
# build tree that reaches hundreds of megabytes, and buildkit would hash and
# transfer it on every build to copy four files out of it.
BUILD_CONTEXTS="boarddeb=boards/cx3576/deb/board-cx3576 hwinit=boards/cx3576/hwinit boardinit=boards/cx3576/bsp/init boardoverlay=boards/cx3576/overlay"

# Six units enabled at multi-user.target: one mos-<n>.service per hwinit fact
# the board declares that is not `bt` -- the Bluetooth program and unit belong
# to mos-bluetooth, so this package ships that fact's conf and not its unit --
# plus mos-status-led.service, which ships because BOARD_HAS_STATUS_LED=1 here.
# The count is a consequence of board.env, and asserting it is what keeps a
# board fact added there from changing this package's enablement unremarked.
ENABLEMENT="mos-board-cx3576=6"
