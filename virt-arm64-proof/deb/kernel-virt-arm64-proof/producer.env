# The kernel producer: the `mica-kernel-virt-arm64-proof` package -- everything the
# assembly's kernel component and image take out of this board's BSP build,
# packed under /usr/lib/mica/board/virt-arm64-proof/. Read by build-env/deb/producers.sh
# and build-env/deb/build.sh; the convention is documented in
# build-env/deb/README.md.
#
# NOT A ROOT PACKAGE. No manifest names it and no root installs it: the
# assembly (mica-build) reads the archive (tools/board-pool.sh there) into
# _out/boards/virt-arm64-proof/ and packs the kernel, the support image and the firmware
# from it. The archive is the transport that lets the image be built from
# the BSP outputs the pin names, on a host that never ran this board's
# kernel build.
PACKAGES="mica-kernel-virt-arm64-proof"

# One archive, the board's own architecture.
ARCHES="arm64"

# Nothing to enable: the payload is not installed into a root at all.
ENABLEMENT="mica-kernel-virt-arm64-proof=0"

# prepare.sh stages the BSP outputs `make kernel` (and the board's other
# targets) wrote to _out/bsp, this board's board.env and evidence.json, the
# firmware files and component copyright the support image takes, and the
# verity trust certificate the kernel was built against. It builds nothing:
# a kernel build is an hour of compiling and the wrong thing to start from
# inside a packaging hook. PREFLIGHT=1 lets build-env/deb/preflight.sh ask
# whether the outputs are there before any producer starts.
PREPARE="prepare.sh"
PREFLIGHT="1"

FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"
BUILD_CONTEXTS="common=boot/common"
