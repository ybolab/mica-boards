# x64 kernel source pin. The compiled kernel enforces signed verity roots
# and supplies the built-in storage/watchdog facilities required by mos-init.
# Version changes also require regenerating and checking the board config.
KERNEL_VERSION=v6.12.107

# `git archive` of the tag, sha256. The TREE is hashed, not a tarball: a
# release tarball can be re-rolled and a tag can be moved, while the archive is
# a deterministic byte stream over the source that is actually compiled.
#
# To bump: change the tag, set the hash to the literal string PENDING, and run
# `make x64-kernel`. The build prints the hash it computed and fails; paste it
# in and run again. There is no environment variable that softens that into a
# warning -- recording a hash is an act rather than a copy from a page nobody
# re-checked.
KERNEL_SHA256=ee126cabb1ce99474d96a1af42458112f16fe3b83a2a7fde581849272b7de74d
