# Independent BM201 / S905X5M BSP facts. No MOS system-image layout is declared.
# Current MOS signed-file boot and image qualification are not implemented here.
# Vendor firmware, kernel, radio and front-panel sources remain under this board.

LAYOUT_BOARD=s905x5m
MOS_ARCH=arm64
BOARD_CMDLINE_ARGS="console=ttyS0,921600 earlycon=aml_uart,0xfe07a000 net.ifnames=0"
BOARD_SIZE_BUDGET_MB=400
BOARD_HAS_STATUS_LED=0
BOARD_HAS_DISPLAY=1
BOARD_DRAM_USABLE_BASE=0x00000000
BOARD_FIRMWARE_FILES="/usr/lib/firmware/SWT6621_IRAM_SDIO.bin /usr/lib/firmware/SWT6621_DRAM_SDIO.bin /usr/lib/firmware/EA6521QF_SEEKWAVE_R00005.bin"
BOARD_RADIOS="wifi bluetooth"
BOARD_RADIO_MODULES="amlogic-wireless skw_sdio skw hci_vhci"
BOARD_RADIO_MODULES_CONF=/etc/mos/wireless.conf
BOARD_USERLAND_FILES="/usr/lib/bluetooth/plugins/libskwbt.so /usr/sbin/skw_vhci_bridge /etc/bluetooth/skwbt.conf /etc/bluetooth/sv6160.nvbin /etc/bluetooth/sv6160lite.nvbin /etc/bluetooth/sv6316.nvbin"
BOARD_HWINIT_PACKAGES="alsa-utils"
BOARD_BLUEZ_CLASS=0x240404
BOARD_HWINIT_CONFS="wireless audio bluetooth"
BOARD_RECOVERY_ACTIONS=""
BOARD_RELEASE_TARGET=0

# Amlogic vendor-owned user-area ranges, outside any current MOS image contract.
# Reserved holds multi-DTB and MMC calibration scratch; env is vendor state.
RESERVED_START_MIB=36
RESERVED_SIZE_MIB=64
ENV_START_MIB=108
ENV_SIZE_MIB=8
