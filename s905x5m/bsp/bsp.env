# What the amlogic family builds for this board: the file names under
# kernel/. Plain KEY=value, included by families/amlogic/Makefile.inc and
# handed to the Dockerfiles as build arguments. The family owns the source
# pins (families/amlogic/family.env); this file owns what is the board's.
KERNEL_CONFIG=kernel-s905x5m.config
# The board's config fragments in merge order; @mos-required is the shared
# floor's place in it (boot/common/mos-required.fragment).
KERNEL_FRAGMENTS=runtime.fragment wireless.fragment @mos-required signed-boot.fragment
KERNEL_DTB=s7d_s905x5m_m100.dtb
KERNEL_DTB_ARTIFACT=s7d_s905x5m_m100.dtb
