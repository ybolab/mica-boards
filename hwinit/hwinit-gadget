#!/bin/sh
# Create the CDC ACM debug console gadget described by /etc/mos/gadget.conf and
# bind it to the first available UDC. With the OTG port in "otg" role the PHY
# only enumerates when a host PC is attached, so binding unconditionally is
# safe: with no host the gadget just sits idle. The serial number is derived
# from the same hardware identity as the MAC addresses (mac.conf seed=), so a
# board keeps its USB identity across image updates.
# Best-effort and idempotent, always exits 0.
CONF=/etc/mos/gadget.conf
[ -r "$CONF" ] || exit 0
conf_get() { sed -n "s/^$1=//p" "$CONF" | head -n1; }
modprobe -q libcomposite 2>/dev/null || true
[ -d /sys/kernel/config/usb_gadget ] || exit 0

g=/sys/kernel/config/usb_gadget/$(conf_get name)
[ "$g" != /sys/kernel/config/usb_gadget/ ] || exit 0
mkdir -p "$g" 2>/dev/null || exit 0

if [ ! -d "$g/strings/0x409" ]; then
    printf '%s\n' "$(conf_get vid)" > "$g/idVendor" 2>/dev/null || true
    printf '%s\n' "$(conf_get pid)" > "$g/idProduct" 2>/dev/null || true
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" 2>/dev/null || true
    serial=$(sed -n 's/^seed=//p' /etc/mos/mac.conf 2>/dev/null | head -n1)
    serial=$(cat "$serial" 2>/dev/null)
    printf '%.32s\n' "${serial:-cx3576}" > "$g/strings/0x409/serialnumber" 2>/dev/null || true
    printf '%s\n' "$(conf_get manufacturer)" > "$g/strings/0x409/manufacturer" 2>/dev/null || true
    printf '%s\n' "$(conf_get product)" > "$g/strings/0x409/product" 2>/dev/null || true
    printf '%s\n' 'CDC ACM debug console' \
        > "$g/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
    printf '%s\n' 120 > "$g/configs/c.1/MaxPower" 2>/dev/null || true
fi

mkdir -p "$g/functions/acm.usb0" 2>/dev/null || exit 0
[ -L "$g/configs/c.1/acm.usb0" ] || \
    ln -s ../../functions/acm.usb0 "$g/configs/c.1/acm.usb0" 2>/dev/null || true

# Binding an already-bound gadget returns EBUSY; only bind when UDC is empty.
[ -e "$g/UDC" ] || exit 0
[ -z "$(cat "$g/UDC" 2>/dev/null)" ] || exit 0
for udc in /sys/class/udc/*; do
    [ -e "$udc" ] || continue
    basename "$udc" > "$g/UDC" 2>/dev/null || true
    break
done
exit 0
