[Unit]
Description=USB CDC ACM debug console gadget
ConditionPathExists=/etc/mos/gadget.conf
# The gadget can only bind once the OTG port role has been set.
After=mos-otg.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mos/hwinit-gadget
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
