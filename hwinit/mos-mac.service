[Unit]
Description=Assign stable MAC addresses to random-address Ethernet ports
ConditionPathExists=/etc/mos/mac.conf
# network-pre.target is the documented sync point for work that must happen
# before any interface is configured; systemd-networkd orders itself after it.
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/lib/mos/hwinit-mac
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
