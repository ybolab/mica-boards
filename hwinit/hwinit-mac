#!/bin/sh
# Give every eth* whose kernel address is random a stable MAC derived from the
# hardware identity named in /etc/mos/mac.conf (seed=<sysfs path>). The eMMC
# CID is a read-only chip register, so the derived address survives a rootfs
# reflash and every image update. Ports that already carry a permanent MAC are
# left untouched. Must run before any network configuration; best-effort and
# idempotent, always exits 0.
CONF=/etc/mos/mac.conf
[ -r "$CONF" ] || exit 0
seed_path=$(sed -n 's/^seed=//p' "$CONF" | head -n1)
[ -n "$seed_path" ] && [ -r "$seed_path" ] || exit 0
seed=$(cat "$seed_path" 2>/dev/null)
[ -n "$seed" ] || exit 0
for net in /sys/class/net/eth*; do
    [ -e "$net" ] || continue
    iface=${net##*/}
    # addr_assign_type 1 = NET_ADDR_RANDOM: the kernel invented this address
    # and it changes every boot. 0 = NET_ADDR_PERM, a real address to keep.
    [ "$(cat "$net/addr_assign_type" 2>/dev/null)" = 1 ] || continue
    # 02: marks a locally administered unicast address, so the result cannot
    # collide with a vendor OUI; the interface name keeps the ports distinct.
    mac=$(printf '%s-%s' "$seed" "$iface" | md5sum | awk \
        '{h=$1;printf "02:%s:%s:%s:%s:%s",substr(h,1,2),substr(h,3,2),substr(h,5,2),substr(h,7,2),substr(h,9,2)}')
    ip link set dev "$iface" down 2>/dev/null || true
    ip link set dev "$iface" address "$mac" 2>/dev/null || true
done
exit 0
