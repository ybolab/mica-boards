[Unit]
Description=Bridge the Seekwave Bluetooth controller into Linux vHCI
ConditionPathExists=/etc/mos/bluetooth.conf
Requires=mos-wireless.service
After=mos-wireless.service var-lib-bluetooth.mount
Before=bluetooth.service
RequiresMountsFor=/var/lib/bluetooth

[Service]
Type=simple
ExecStart=/usr/lib/mos/hwinit-bluetooth
Restart=on-failure
RestartSec=2
TimeoutStartSec=25

[Install]
WantedBy=multi-user.target
