# Board hardware and storage policy contain no kernel or boot executable.
PACKAGES="mica-board-cx3576"
ARCHES="arm64"
BUILD_CONTEXTS="board=cx3576 boarddeb=cx3576/deb/board-cx3576 common=boot/common hwinit=cx3576/hwinit boardinit=cx3576/bsp/init boardoverlay=cx3576/overlay"
ENABLEMENT="mica-board-cx3576=6"
