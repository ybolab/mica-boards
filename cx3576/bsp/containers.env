# The container engine ships on this board.
#
# cx3576 has the rootfs slot for it (317 MB installed against a 400 MB budget
# with the engine present) and the kernel for it — all twenty container
# options are =y in kernel/config/kernel-cx3576z.config, measured 2026-08-23.
#
# A board that cannot afford ~107 MB, or has no use for containers, ships this
# file with WITH_CONTAINERS=0 instead. Absent means 1: a new board gets the
# engine unless it says otherwise.
WITH_CONTAINERS=1
