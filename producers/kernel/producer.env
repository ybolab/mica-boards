# The bundle producer, once per board: the `mica-kernel-<board>` package --
# everything the assembly's kernel component and image take out of the
# board's BSP build, packed under /usr/lib/mica/board/<board>/. FOR_EACH
# runs it over every boards/<board>/board.env, whose assignments name the
# instance below. Read by build-env/deb/producers.sh and build-env/deb/build.sh;
# the convention is documented in build-env/deb/README.md.
#
# NOT A ROOT PACKAGE. No manifest names it and no root installs it: the
# assembly (mica-build) reads the bundle (deps/boards/<board>.json, its
# artifact) into _out/boards/<board>/ and packs the kernel, the support image
# and the firmware from it. The archive is what the package gate gates and
# what tools/publish-boards.sh pushes as the board's artifact.
FOR_EACH=boards/*/board.env
PACKAGES="mica-kernel-${LAYOUT_BOARD}"
ARCHES="${MICA_ARCH}"
ENABLEMENT="mica-kernel-${LAYOUT_BOARD}=0"
PREPARE="prepare.sh"
PREFLIGHT="1"
FROM_IMAGES="MICA_BUILD_DEB=LOCAL_MICA_BUILD_DEB"
BUILD_CONTEXTS="board=boards/${LAYOUT_BOARD} common=boot/common"
CONTROL_DIR="boards/${LAYOUT_BOARD}/kernel/control"
