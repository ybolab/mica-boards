# The rockchip family: the Rockchip vendor kernel tree as Armbian carries it,
# mainline U-Boot with the vendor DDR initialiser and BL31 out of rkbin, a
# signed FIT booted by the Mica file-boot command. Plain KEY=value, read by
# Makefile.inc and handed to the Dockerfiles as build arguments; a command-line
# KERNEL_COMMIT=... to make overrides a value here for one build.
KERNEL_REPO=https://github.com/armbian/linux-rockchip.git
KERNEL_COMMIT=c6157104418d012823413c02f9222f3fe123dd25
KERNEL_EXPECT=6.1.115
RKBIN_REPO=https://github.com/rockchip-linux/rkbin.git
RKBIN_COMMIT=ecb4fcbe954edf38b3ae037d5de6d9f5bccf81f4
UBOOT_REPO=https://github.com/u-boot/u-boot.git
UBOOT_COMMIT=ece349ade2973e220f524ce59e59711cc919263f
