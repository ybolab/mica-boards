# The amlogic family: the Hardkernel vendor kernel tree (Amlogic 6.12 with
# common_drivers), CoreELEC's U-Boot with the vendor BL2/BL31 blobs, a signed
# FIT booted by the Mica file-boot command. Plain KEY=value, read by
# Makefile.inc and handed to the Dockerfiles as build arguments; a
# command-line KERNEL_COMMIT=... to make overrides a value here for one build.
KERNEL_REPO=https://github.com/hardkernel/linux.git
KERNEL_COMMIT=9ea2aa831a585955dcb0e38a0bc3c63d2c690adc
KERNEL_EXPECT=6.12.38-m100-arm64
UBOOT_REPO=https://github.com/CoreELEC/u-boot.git
UBOOT_COMMIT=5f7ac2b1dc4df2f466ed88c3958a8675873f8a1a
