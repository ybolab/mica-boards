# The uefi family: a mainline stable kernel for a UEFI machine, booted through
# systemd-boot with a signed UKI. Plain KEY=value, read by Makefile.inc and
# handed to kernel/Dockerfile as build arguments; a board pins the tag and
# the tree hash in its own bsp/kernel/versions.env.
KERNEL_SOURCE=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
